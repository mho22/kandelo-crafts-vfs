-use dlib::dlopen_external_library;
+#[cfg(not(target_os = "kandelo"))]
+use dlib::dlopen_external_library as xkb_library;
 use log::info;
 use once_cell::sync::OnceCell;
 
-#[cfg(feature = "x11")]
+#[cfg(all(feature = "x11", not(target_os = "kandelo")))]
 pub mod x11;
 
+// Kandelo links libxkbcommon statically (build.rs): the handle structs
+// point at the linked functions, and `open` cannot fail.
+#[cfg(target_os = "kandelo")]
+macro_rules! xkb_library {
+    ($structname: ident, functions: $(fn $fname: ident($($farg: ty),*) -> $fret: ty),+,) => (
+        pub struct $structname {
+            $(pub $fname: unsafe extern "C" fn($($farg),*) -> $fret,)+
+        }
+
+        impl $structname {
+            pub unsafe fn open(_name: &str) -> Result<$structname, dlib::DlError> {
+                #[allow(improper_ctypes)]
+                extern "C" {
+                    $(fn $fname($(_: $farg),*) -> $fret;)+
+                }
+                Ok($structname { $($fname,)+ })
+            }
+        }
+    );
+}
