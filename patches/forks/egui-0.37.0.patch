# egui 0.37.0: target_arch = "wasm32" means the browser here; Kandelo takes
# the native path. Every such cfg reads
# all(target_arch = "wasm32", not(target_os = "kandelo")).
diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	2026-10-29 17:52:05
+++ b/Cargo.toml	2026-10-29 17:52:33
@@ -205,7 +205,7 @@
 ]
 default-features = false
 
-[target.'cfg(target_arch = "wasm32")'.dependencies.web-sys]
+[target.'cfg(all(target_arch = "wasm32", not(target_os = "kandelo")))'.dependencies.web-sys]
 version = "0.3.103"
 features = ["File"]
 optional = true
diff -ruN a/src/data/input/dropped_file.rs b/src/data/input/dropped_file.rs
--- a/src/data/input/dropped_file.rs	2026-10-29 17:52:05
+++ b/src/data/input/dropped_file.rs	2026-10-29 17:52:33
@@ -1,7 +1,7 @@
 use alloc::sync::Arc;
 use std::path::Path;
 
-#[cfg(target_arch = "wasm32")]
+#[cfg(all(target_arch = "wasm32", not(target_os = "kandelo")))]
 use core::{future::Future, pin::Pin};
 
 /// A file dropped into egui.
@@ -22,7 +22,7 @@
     /// # Errors
     ///
     /// Returns an error if the browser cannot read the file.
-    #[cfg(target_arch = "wasm32")]
+    #[cfg(all(target_arch = "wasm32", not(target_os = "kandelo")))]
     fn bytes_async(&self) -> Pin<Box<dyn Future<Output = Result<Vec<u8>, String>> + '_>>;
 
     /// Read the file contents.
@@ -30,13 +30,13 @@
     /// # Errors
     ///
     /// Returns an error if the file cannot be read.
-    #[cfg(not(target_arch = "wasm32"))]
+    #[cfg(not(all(target_arch = "wasm32", not(target_os = "kandelo"))))]
     fn bytes(&self) -> Result<Vec<u8>, String>;
 
     /// The browser file handle, if this file was dropped on the web.
     ///
     /// Requires the `web_file` feature.
-    #[cfg(all(target_arch = "wasm32", feature = "web_file"))]
+    #[cfg(all(all(target_arch = "wasm32", not(target_os = "kandelo")), feature = "web_file"))]
     fn web_file(&self) -> Option<&web_sys::File> {
         None
     }
