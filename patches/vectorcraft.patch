 egui_extras = { git = "https://github.com/storytold/egui.git", rev = "6d518fc799681571963842f95b55a6b68431b15a" }
 egui_kittest = { git = "https://github.com/storytold/egui.git", rev = "6d518fc799681571963842f95b55a6b68431b15a" }
-egui_system_font_provider = { git = "https://github.com/storytold/egui.git", rev = "6d518fc799681571963842f95b55a6b68431b15a" }
 eframe = { git = "https://github.com/storytold/egui.git", rev = "6d518fc799681571963842f95b55a6b68431b15a" }
-egui_demo_lib = { git = "https://github.com/storytold/egui.git", rev = "6d518fc799681571963842f95b55a6b68431b15a" }
-egui_inspection = { git = "https://github.com/storytold/egui.git", rev = "6d518fc799681571963842f95b55a6b68431b15a" }
 winit = { git = "https://github.com/storytold/winit.git", rev = "a517b3846ee8457d84ee4975110bfda6797c44dc" }
diff -ruN a/apps/vectorcraft/Cargo.toml b/apps/vectorcraft/Cargo.toml
--- a/apps/vectorcraft/Cargo.toml	2026-10-29 21:03:56
+++ b/apps/vectorcraft/Cargo.toml	2026-10-30 13:25:18
@@ -21,13 +21,17 @@
 # Shared across the Craft suite: decides who draws the window frame per desktop (compositor vs app)
 # so VectorCraft matches the rest on Linux. `egui` adds `craft_window::decorate`. See #217.
 craft-window = { workspace = true }
-eframe = { workspace = true, features = ["clipboard", "default_fonts", "wayland", "x11"] }
+eframe = { workspace = true, features = ["clipboard", "default_fonts", "wayland"] }
 egui = { workspace = true }
 serde_json = { workspace = true }
 log = { workspace = true }
 chrono = { workspace = true }
 
-[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+# Kandelo has no X server: Wayland only.
+[target.'cfg(not(target_os = "kandelo"))'.dependencies]
+eframe = { workspace = true, features = ["x11"] }
+
+[target.'cfg(not(all(target_arch = "wasm32", not(target_os = "kandelo"))))'.dependencies]
 rfd = { workspace = true }
 # wayland-data-control: native Wayland clipboard (Linux; X11 through XWayland only sees what X11 apps copied).
 arboard = { workspace = true, features = ["image-data", "wayland-data-control"] }
