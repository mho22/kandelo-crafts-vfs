# the native path. Every such cfg reads
# all(target_arch = "wasm32", not(target_os = "kandelo")).
diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	2026-10-29 17:52:05
+++ b/Cargo.toml	2026-10-29 17:52:34
@@ -205,7 +205,7 @@
