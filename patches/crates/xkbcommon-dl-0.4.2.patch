# xkbcommon-dl 0.4.2: Kandelo links libxkbcommon statically (found with
# pkg-config); the handles point at the linked functions, not dlsym's.
# Kandelo has no X server: no libxkbcommon-x11 module.
diff -ruN a/build.rs b/build.rs
--- a/build.rs	1970-01-01 01:00:00
+++ b/build.rs	2026-10-08 18:09:38
@@ -0,0 +1,25 @@
+use std::env;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-env-changed=PKG_CONFIG");
+    println!("cargo:rerun-if-env-changed=PKG_CONFIG_PATH");
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("kandelo") {
+        return;
+    }
+    let pkg_config = env::var("PKG_CONFIG").unwrap_or_else(|_| "pkg-config".into());
+    let output = Command::new(&pkg_config)
+        .args(["--static", "--libs", "xkbcommon"])
+        .output()
+        .unwrap_or_else(|e| panic!("cannot run {pkg_config}: {e}"));
+    if !output.status.success() {
+        panic!("{pkg_config} --static --libs xkbcommon: {}", String::from_utf8_lossy(&output.stderr));
+    }
+    for flag in String::from_utf8(output.stdout).unwrap().split_whitespace() {
+        if let Some(dir) = flag.strip_prefix("-L") {
+            println!("cargo:rustc-link-search=native={dir}");
+        } else if let Some(lib) = flag.strip_prefix("-l") {
+            println!("cargo:rustc-link-lib=static={lib}");
+        }
+    }
+}
