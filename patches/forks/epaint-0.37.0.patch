-[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.vello_cpu]
+[target.'cfg(not(all(target_arch = "wasm32", not(target_os = "kandelo"))))'.dev-dependencies.vello_cpu]
 version = "0.2.0"
 features = [
     "std",
diff -ruN a/src/mutex.rs b/src/mutex.rs
--- a/src/mutex.rs	2026-10-29 17:52:05
+++ b/src/mutex.rs	2026-10-29 17:52:34
@@ -155,7 +155,7 @@
     }
 }
 
-#[cfg(not(target_arch = "wasm32"))]
+#[cfg(not(all(target_arch = "wasm32", not(target_os = "kandelo"))))]
